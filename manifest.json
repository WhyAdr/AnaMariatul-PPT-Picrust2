  "figures": [
    {
      "stem": "01_community_context",
      "title": "SC | Community context",
      "caption": "Read assignment and fungal phylum resolution share the denominator of 52,404 preprocessed reads. Outside fungal input includes other/uncertain core ITS plus ambiguous and unassigned reads. Fungal origin without resolved phylum is retained explicitly. These are sequencing read proportions, not biomass or cell proportions.",
      "source_tables": [
        "read_assignment_context.tsv",
        "phylum_context.tsv"
      ]
    },
    {
      "stem": "02_guild_annotation_coverage",
      "title": "SC | Ecological annotation coverage",
      "caption": "Panel A retains the unassigned and outside-input fractions using all 52,404 preprocessed reads. Panel B separates read-weighted coverage from the percentage of 34 fungal-input OTUs annotated. Original Y-only chimera exclusion was used; borderline OTU_9 is included. Database-specific ranks and confidence schemes differ.",
      "source_tables": [
        "guild_coverage.tsv"
      ]
    },
    {
      "stem": "03_guild_lifestyle_composition",
      "title": "SC | Putative lifestyles and guilds",
      "caption": "FungalTraits primary and secondary fields are plotted separately and are not added together. FUNGuild retains combined guild labels and Probable/Highly Probable calls. Bar lengths are percentages of all preprocessed reads, not percentages of the small annotated subset. Hatching identifies the contribution of reference-chimera-borderline OTU_9. Labels are taxon-associated hypotheses, not observations of disease or activity.",
      "source_tables": [
        "guild_lifestyle_composition.tsv"
      ]
    },
    {
      "stem": "04_guild_sensitivity",
      "title": "SC | Sensitivity of ecological annotations",
      "caption": "Panel A recomputes existing annotation totals after omitting OTU_9; the underlying annotation workflow was not rerun. Both policies use the same denominator of 52,404 reads. Panel B compares the three existing clustering/refinement workflows under their original Y-only chimera exclusion rules. Similar totals across workflows are technical stability evidence, not biological replication. No error bars or significance tests are warranted.",
      "source_tables": [
        "guild_borderline_sensitivity.tsv"
      ]
    },
    {
      "stem": "05_picrust2_diagnostics",
      "title": "SC | PICRUSt2 representation and reference distance",
      "caption": "PICRUSt2 retained 27 of 34 fungal-input OTUs after excluding five alignment failures and two OTUs above NSTI 2. The 28,587 represented reads are 54.55% of preprocessed and 27.75% of delivered raw reads. NSTI is phylogenetic distance, not percent mismatch. The weighted value uses ITS-copy-normalized abundance after filtering. Panel C applies hypothetical NSTI cutoffs to existing placed OTUs; it is not a rerun or accuracy calibration.",
      "source_tables": [
        "picrust2_retention.tsv",
        "otu_annotation_and_nsti.tsv",
        "picrust2_nsti_threshold_retention.tsv"
      ]
    },
    {
      "stem": "06_picrust2_ec_profile",
      "title": "SC | Predicted enzyme categories",
      "caption": "The 15 largest EC predictions are ranked by unstratified predicted abundance. Names and entry status come from the installed PICRUSt2 description maps. Entries labelled transferred or deleted in the bundled map are gray; original IDs and counts are preserved and are not automatically reassigned to one or more successor ECs. Broad classes sum original predicted gene-family abundances; these totals are not read percentages or independent ecosystem functions. Predictions are not enzyme assays or measured gene counts. All 840 categories are provided in the source table.",
      "source_tables": [
        "ec_predicted_profiles.tsv",
        "ec_class_profile.tsv",
        "ec_reference_status_summary.tsv"
      ]
    },
    {
      "stem": "07_picrust2_pathway_profile",
      "title": "SC | Predicted MetaCyc pathway profile",
      "caption": "The top 20 MetaCyc pathways are ranked by predicted abundance from the original fungal pathway output. Descriptions come from the installed PICRUSt2 map. Hatched portions are existing stratified contributions from borderline OTU_9; their sums reconcile with unstratified abundance. Removing these portions visually is not a rerun of pathway inference. Pathways overlap in component reactions and should not be interpreted as mutually exclusive fractions of reads or activity.",
      "source_tables": [
        "metacyc_predicted_profiles.tsv"
      ]
    },
    {
      "stem": "08_picrust2_otu_contributions",
      "title": "SC | Which OTUs drive the pathway predictions?",
      "caption": "Cell values are each OTU contribution divided by the total predicted abundance of that pathway. Every row sums to 100%; this is not a heatmap comparing biological samples. OTUs are ordered by normalized abundance, not hierarchical clustering. Values at least 10% are printed; the color scale saturates above 40%. OTU_9 is marked because of its borderline reference-chimera call. Per-OTU NSTI and taxonomy are provided in the linked audit table.",
      "source_tables": [
        "top_pathways_otu_contribution_percent.tsv",
        "otu_annotation_and_nsti.tsv"
      ]
    }
  ],
